# Leaf5 分区挂载表
/boot            emmc      /dev/block/bootdevice/by-name/boot
/recovery        emmc      /dev/block/bootdevice/by-name/recovery
/system          ext4      /dev/block/mapper/system                      flags=display="System";backup=1;wipeingui
/system_ext      ext4      /dev/block/mapper/system_ext                  flags=display="System Ext";backup=1
/product         ext4      /dev/block/mapper/product                     flags=display="Product";backup=1
/vendor          ext4      /dev/block/mapper/vendor                      flags=display="Vendor";backup=1
/odm             ext4      /dev/block/mapper/odm                         flags=display="ODM";backup=1
/data            f2fs      /dev/block/bootdevice/by-name/userdata        flags=display="Data";backup=1;wipeingui
/cache           ext4      /dev/block/bootdevice/by-name/cache           flags=display="Cache";wipeingui;backup=1
/metadata        ext4      /dev/block/bootdevice/by-name/metadata        flags=display="Metadata";backup=1
/persist         ext4      /dev/block/bootdevice/by-name/persist         flags=display="Persist";backup=1
/misc            emmc      /dev/block/bootdevice/by-name/misc            flags=display="Misc";backup=1
/dtbo            emmc      /dev/block/bootdevice/by-name/dtbo            flags=display="DTBO";backup=1;flashimg=1
/vbmeta          emmc      /dev/block/bootdevice/by-name/vbmeta          flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system   emmc      /dev/block/bootdevice/by-name/vbmeta_system   flags=display="VBMeta System";backup=1;flashimg=1
