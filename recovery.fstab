# Leaf5 VAB + 内部存储模拟SD卡
# 逻辑分区（super 分区内）
/system         ext4     system                                     flags=display=system;logical;slotselect;backup=1;wipeingui
/system_ext     ext4     system_ext                                 flags=display=system_ext;logical;slotselect;backup=1
/vendor         ext4     vendor                                     flags=display=vendor;logical;slotselect;backup=1
/odm            ext4     odm                                        flags=display=odm;logical;slotselect;backup=1
/product        ext4     product                                    flags=display=product;logical;slotselect;backup=1

# 物理分区
/metadata       ext4     /dev/block/by-name/metadata                flags=display=metadata;backup=1
/data           f2fs     /dev/block/bootdevice/by-name/userdata     flags=display=data;backup=1;wipeingui;length=-16384
/boot           emmc     /dev/block/bootdevice/by-name/boot         flags=display=boot;slotselect;flashimg=1
/recovery       emmc     /dev/block/bootdevice/by-name/recovery     flags=display=recovery;slotselect;flashimg=1
/misc           emmc     /dev/block/bootdevice/by-name/misc         flags=display=misc;backup=1

# 高通特定
/persist        ext4     /dev/block/bootdevice/by-name/persist      flags=display=persist;backup=1
/dtbo           emmc     /dev/block/bootdevice/by-name/dtbo         flags=display=dtbo;slotselect;flashimg=1
/vbmeta         emmc     /dev/block/bootdevice/by-name/vbmeta       flags=display=vbmeta;slotselect;flashimg=1

# 注意：删除了 /sdcard 条目！
# RECOVERY_SDCARD_ON_DATA := true 会自动处理 /sdcard 挂载到 /data/media/0
